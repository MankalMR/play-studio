# ============================================================
# Play Studio — Environment Variables
# ============================================================
# Variables prefixed with VITE_ are exposed to the browser.
# ============================================================

# ---------- AI / Gemini ----------
# Required: Google Gemini API key
GEMINI_API_KEY=

# ---------- SEO & Site Identity ----------
# Optional: App URL (canonical base URL)
VITE_APP_URL=https://play.mankala.space

# ---------- Server Configuration ----------
# Port for the local express server
PORT=3000
NODE_ENV=development
